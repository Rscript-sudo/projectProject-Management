{
  "_comment": "园林监理全过程 SOP v2",
  "_适用项目类型": ["园林", "绿化", "景观"],
  "_禁用条款": ["塔吊附墙", "机柜配线", "路基沥青压实", "钢结构焊缝探伤"],
  "_字数下限": {"监理日志": 200, "监理周报": 800, "监理月报": 1600},
  "sections": {
    "开工条件": {"必含要点": ["土壤检测与场地排水条件确认", "苗木清单及样品确认", "种植方案已审批"], "禁用术语": []},
    "巡视检查": {"必含要点": ["苗木长势与病虫害", "支撑绑扎稳固", "灌溉排水正常"], "禁用术语": ["混凝土塌落度"]},
    "旁站": {"必含要点": ["大树吊装种植", "种植土回填与树穴施工", "景观水体防水试水"], "禁用术语": []},
    "平行检验": {"必含要点": ["种植土厚度与 pH 复测", "苗木胸径冠幅抽测", "铺装平整度与坡度实测"], "禁用术语": []},
    "见证取样": {"必含要点": ["种植土、肥料取样", "铺装材料送检", "苗木产地检疫资料核验"], "禁用术语": []},
    "质量验收": {"必含要点": ["苗木成活率和覆盖率达标", "灌溉照明系统试运行", "养护期记录完整"], "禁用术语": []}
  }
}
